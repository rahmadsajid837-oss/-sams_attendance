{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based attributes for Teachers and Students.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "fullName": { "type": "string", "maxLength": 100, "description": "Full legal name" },
        "email": { "type": "string", "maxLength": 150, "description": "Institutional email address" },
        "phoneNumber": { "type": "string", "maxLength": 15, "description": "11-digit phone number" },
        "role": { "type": "string", "enum": ["teacher", "student"], "description": "User access role" },
        "institutionId": { "type": "string", "maxLength": 50, "description": "Affiliated institution identifier" },
        "fcmToken": { "type": "string", "maxLength": 300, "description": "Firebase Cloud Messaging push token" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["uid", "fullName", "email", "role", "phoneNumber", "createdAt"]
    },
    "Class": {
      "title": "Class",
      "description": "Academic course or subject created and managed by a Teacher.",
      "type": "object",
      "properties": {
        "classId": { "type": "string", "maxLength": 64, "description": "Unique class identifier" },
        "className": { "type": "string", "maxLength": 120, "description": "Class title (e.g. Database Systems)" },
        "classCode": { "type": "string", "maxLength": 30, "description": "Short code (e.g. CS-301)" },
        "description": { "type": "string", "maxLength": 500, "description": "Class details and syllabus description" },
        "teacherId": { "type": "string", "maxLength": 64, "description": "UID of the Teacher who created the class" },
        "institutionId": { "type": "string", "maxLength": 50, "description": "Institutional identifier" },
        "enrolledStudentIds": { "type": "array", "description": "List of student UIDs enrolled in the class" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["classId", "className", "teacherId", "createdAt"]
    },
    "Session": {
      "title": "Session",
      "description": "An attendance taking session for a specific class and date.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 64, "description": "Unique session identifier" },
        "classId": { "type": "string", "maxLength": 64, "description": "Associated class identifier" },
        "teacherId": { "type": "string", "maxLength": 64, "description": "UID of the teacher recording the session" },
        "sessionDate": { "type": "string", "description": "Date of the session in YYYY-MM-DD format" },
        "sessionTime": { "type": "string", "description": "Time of the session in HH:mm format" },
        "totalPresent": { "type": "number", "description": "Count of present students" },
        "totalAbsent": { "type": "number", "description": "Count of absent students" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["sessionId", "classId", "teacherId", "sessionDate", "createdAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Individual student attendance status entry for a session.",
      "type": "object",
      "properties": {
        "attendanceId": { "type": "string", "maxLength": 100, "description": "Unique attendance record ID (sessionId_studentId)" },
        "sessionId": { "type": "string", "maxLength": 64, "description": "Associated session ID" },
        "classId": { "type": "string", "maxLength": 64, "description": "Associated class ID" },
        "studentId": { "type": "string", "maxLength": 64, "description": "UID of the student" },
        "studentName": { "type": "string", "maxLength": 100, "description": "Cached student name" },
        "teacherId": { "type": "string", "maxLength": 64, "description": "UID of the teacher" },
        "status": { "type": "string", "enum": ["present", "absent"], "description": "Attendance status" },
        "sessionDate": { "type": "string", "description": "Session date YYYY-MM-DD" },
        "pendingSync": { "type": "boolean", "description": "Hive synchronization state" },
        "syncedAt": { "type": "string", "format": "date-time", "description": "Timestamp of Firestore synchronization" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Record creation timestamp" }
      },
      "required": ["attendanceId", "sessionId", "classId", "studentId", "teacherId", "status", "sessionDate", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Push notification and in-app alert log for students.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "maxLength": 64, "description": "Unique notification ID" },
        "userId": { "type": "string", "maxLength": 64, "description": "Recipient student UID" },
        "title": { "type": "string", "maxLength": 100, "description": "Notification title" },
        "message": { "type": "string", "maxLength": 300, "description": "Notification body" },
        "type": { "type": "string", "enum": ["attendance_update", "absence_alert", "class_reminder"], "description": "Notification category" },
        "classId": { "type": "string", "maxLength": 64, "description": "Related class ID" },
        "sessionId": { "type": "string", "maxLength": 64, "description": "Related session ID" },
        "read": { "type": "boolean", "description": "Read status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp" }
      },
      "required": ["notificationId", "userId", "title", "message", "type", "createdAt", "read"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles. Teachers manage their classes; Students view their profiles."
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Class" },
      "description": "Classes created by teachers and viewable by enrolled students."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Attendance sessions created per class per date by teachers."
    },
    "/attendance_records/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Granular attendance records marked by teachers and readable by individual students."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Attendance alerts and reminders for students."
    }
  }
}
